# ============================================================================
# GENERATED BY TERRAFORM — DO NOT EDIT BY HAND.
# Re-run `terraform apply` to regenerate after changing node definitions.
# Hand-authored tuning lives in ansible/inventory/group_vars/, which is
# never overwritten.
# ============================================================================
[k3s_server]
%{ for name, node in servers ~}
${name} ansible_host=${node.ip}
%{ endfor ~}

[k3s_agent]
%{ for name, node in agents ~}
${name} ansible_host=${node.ip}
%{ endfor ~}

[k3s:children]
k3s_server
k3s_agent

[all:vars]
ansible_user=${ansible_user}
